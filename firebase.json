{
  "hosting": {
    "public": "public",
    "ignore": ["_redirects", "**/.*"],
    "rewrites": [
      { "source": "/api/insta", "function": { "functionId": "insta", "region": "europe-west1" } }
    ],
    "headers": [
      { "source": "/spots.json", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
      { "source": "/index.html", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] }
    ]
  },
  "functions": [{ "source": "functions", "codebase": "default", "runtime": "nodejs22" }],
  "firestore": { "rules": "firestore.rules" }
}
