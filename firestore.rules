rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Seul le compte administrateur (connexion Google) peut modifier le contenu.
    function isAdmin() {
      return request.auth != null && request.auth.token.email == "evangaberelinvest@gmail.com"
        && request.auth.token.email_verified == true;
    }

    // Tout le contenu du site (questions, prix, lieux…) : lecture publique, écriture admin.
    match /{collection}/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Classement : chaque joueur ne modifie que sa propre ligne.
    match /scores/{uid} {
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(["name", "s", "at"])
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 20
        && request.resource.data.s is map;
    }
  }
}
