rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Seul le compte administrateur (créé dans Firebase > Authentication) peut modifier le contenu.
    function isAdmin() {
      return request.auth != null && request.auth.token.email == "EMAIL_ADMIN";
    }

    // Classement : tout le monde lit, chaque joueur ne modifie que sa propre ligne.
    match /scores/{uid} {
      allow read: if true;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(["name", "s", "at"])
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 20
        && request.resource.data.s is map;
      allow delete: if isAdmin();
    }

    // Questions du quiz et objets de « Devine le prix » : lecture publique, écriture admin.
    match /questions/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /prix/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
