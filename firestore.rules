rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Seul le compte administrateur (connexion Google) peut modifier le contenu.
    function isAdmin() {
      return request.auth != null && request.auth.token.email == "evangaberelinvest@gmail.com"
        && request.auth.token.email_verified == true;
    }

    // Tout le contenu du site (questions, prix, lieux…) : lecture publique, écriture admin.
    // Sauf « prive » (jeton Instagram) : personne ne peut le lire depuis le site.
    match /{collection}/{id} {
      allow read: if collection != "prive" && collection != "poker_tables" && collection != "stats_parties";
      allow write: if isAdmin();
    }

    // Profil du joueur : son numéro de maire (Maire0002) et son pseudo, écrits par lui seul
    match /joueurs/{uid} {
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(["numero", "pseudo", "google"])
        && request.resource.data.get("pseudo", "").size() <= 20;
    }
    // Compteur des numéros de maire : on ne peut que l'augmenter de 1
    match /compteurs/maires {
      allow create: if request.auth != null && request.resource.data.n == 1 && request.resource.data.keys().hasOnly(["n"]);
      allow update: if request.auth != null && request.resource.data.n == resource.data.n + 1 && request.resource.data.keys().hasOnly(["n"]);
    }

    // Statistiques du Maire de Paris : une fiche par partie de joueur, écrite par ce joueur, lue seulement par l'admin
    match /stats_parties/{id} {
      allow read: if isAdmin();
      allow create, update: if request.auth != null && request.resource.data.uid == request.auth.uid
        && id.size() <= 60 && request.resource.data.size() <= 60
        && (resource == null || resource.data.uid == request.auth.uid);
      allow delete: if isAdmin();
    }

    // Vote de la communauté (Maire de Paris) : un compteur par dossier et par réponse (c0 à c3).
    // On ne peut qu'ajouter une voix, à une seule réponse à la fois.
    function plusUn(k) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([k])
        && request.resource.data[k] == resource.data.get(k, 0) + 1;
    }
    match /votes/{id} {
      allow create: if request.auth != null && id.size() <= 80
        && request.resource.data.keys().hasOnly(["c0", "c1", "c2", "c3"]) && request.resource.data.size() == 1
        && (request.resource.data.get("c0", 0) == 1 || request.resource.data.get("c1", 0) == 1
          || request.resource.data.get("c2", 0) == 1 || request.resource.data.get("c3", 0) == 1);
      allow update: if request.auth != null && request.resource.data.keys().hasOnly(["c0", "c1", "c2", "c3"])
        && (plusUn("c0") || plusUn("c1") || plusUn("c2") || plusUn("c3"));
    }

    // Poker entre joueurs : file d'attente (chacun sa ligne ; un autre joueur peut seulement y inscrire la table créée)
    match /poker_attente/{uid} {
      allow create: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(["at", "nom", "table"]) && request.resource.data.nom is string && request.resource.data.nom.size() <= 20;
      allow update: if request.auth != null && (request.auth.uid == uid
        || (resource.data.table == null && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["table"]) && request.resource.data.table is string));
      allow delete: if request.auth != null && request.auth.uid == uid;
    }
    // Sessions du Maire de Paris (21 places) : tout joueur connecté peut en rejoindre une et la faire avancer
    match /sessions/{id} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.etat is string && request.resource.data.etat.size() < 100000
        && request.resource.data.joueurs is list && request.auth.uid in request.resource.data.joueurs;
      allow update: if request.auth != null && request.resource.data.etat is string && request.resource.data.etat.size() < 100000
        && (request.auth.uid in resource.data.joueurs || request.auth.uid in request.resource.data.joueurs);
      // Le dernier joueur qui part supprime la session (la session de base « victor-hugo » ne disparaît jamais)
      allow delete: if request.auth != null && id != "victor-hugo" && request.auth.uid in resource.data.joueurs;
    }
    // Tables de poker : seuls les deux joueurs les lisent et les modifient
    match /poker_tables/{id} {
      allow read: if request.auth != null && request.auth.uid in resource.data.joueurs;
      allow create: if request.auth != null && request.resource.data.joueurs is list && request.resource.data.joueurs.size() == 2
        && request.auth.uid in request.resource.data.joueurs && request.resource.data.etat is string && request.resource.data.etat.size() < 20000;
      allow update: if request.auth != null && request.auth.uid in resource.data.joueurs
        && request.resource.data.joueurs == resource.data.joueurs && request.resource.data.etat is string && request.resource.data.etat.size() < 20000;
    }

    // Classement : chaque joueur ne modifie que sa propre ligne.
    match /scores/{uid} {
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(["name", "s", "at"])
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 20
        && request.resource.data.s is map;
    }
  }
}
